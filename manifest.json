{
  "pluginApiVersion": 1,
  "id": "salvage-plugin-simkl",
  "name": "SIMKL",
  "version": "0.3.4",
  "runtime": { "entry": "dist/plugin.js" },
  "provides": [
    {
      "data": "link-preview",
      "command": "preview",
      "when": { "link.host": ["simkl.com"] },
      "timeoutMs": 12000,
      "settings": []
    }
  ],
  "contributes": [
    {
      "id": "episodes",
      "slot": "entry.detail.link.action",
      "when": { "link.host": ["simkl.com"] },
      "ui": { "kind": "button", "label": "Episodes", "icon": "list" },
      "view": "episodes",
      "command": "episodes",
      "timeoutMs": 30000
    }
  ],
  "canvas": {
    "command": "catalogue",
    "name": "Watchlist",
    "icon": "film",
    "refreshMs": 900000,
    "settings": [
      {
        "key": "type",
        "kind": "select",
        "label": "Shows, anime or films",
        "default": "shows",
        "options": [
          { "value": "shows", "label": "TV shows" },
          { "value": "anime", "label": "Anime" },
          { "value": "movies", "label": "Movies" }
        ]
      },
      {
        "key": "lists",
        "kind": "multiselect",
        "label": "Which of my lists",
        "description": "Only the items on these lists are shown. Nothing ticked means all of them. Films have no watching or hold list.",
        "default": "watching,plantowatch,completed",
        "options": [
          { "value": "watching", "label": "Watching" },
          { "value": "plantowatch", "label": "Plan to watch" },
          { "value": "completed", "label": "Completed" },
          { "value": "hold", "label": "On hold" },
          { "value": "dropped", "label": "Dropped" }
        ]
      },
      {
        "key": "perPage",
        "kind": "number",
        "label": "How many entries",
        "description": "The canvas asks for this many at a time and loads more as you scroll.",
        "default": 30,
        "min": 5,
        "max": 50
      }
    ]
  },
  "settings": [
    {
      "key": "clientId",
      "kind": "secret",
      "label": "SIMKL client id",
      "description": "From the SIMKL app you create. It is public, but it is kept on this computer beside the token.",
      "maxLength": 60
    },
    {
      "key": "token",
      "kind": "secret",
      "label": "SIMKL access token",
      "description": "Written by the helper when you approve this computer on simkl.com.",
      "maxLength": 200
    },
    {
      "key": "refreshToken",
      "kind": "secret",
      "label": "SIMKL refresh token",
      "description": "Written by the helper too, so a canvas keeps working when the access token runs out.",
      "maxLength": 200
    }
  ],
  "auth": {
    "url": "https://simkl.com/settings/developer/",
    "urlLabel": "SIMKL developer settings",
    "callbackPath": "/v1/plugins/salvage-plugin-simkl/oauth/callback",
    "authorize": "https://simkl.com/oauth2/authorize",
    "clientIdKey": "clientId",
    "tokenUrl": "https://api.simkl.com/oauth2/token",
    "scopes": "media:read",
    "issuer": "https://simkl.com",
    "refreshSecret": "refreshToken",
    "secret": "token",
    "check": "whoami",
    "note": "Sign in on this computer only. The helper opens SIMKL's consent page, exchanges the code here, and keeps the token; nothing about it reaches your account."
  }
}
